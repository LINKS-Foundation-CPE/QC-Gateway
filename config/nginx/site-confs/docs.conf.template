server {
    listen 443 ssl;
    listen [::]:443 ssl;

    server_name docs.${BASE_DOMAIN};

    include /config/nginx/ssl.conf;

    # Redirect-only vhost: it gives this deployment a stable docs.<domain> entry
    # point that points at wherever the documentation is actually hosted.
    # Both targets come from .env; configure_nginx.sh skips this vhost entirely
    # when DOCS_URL is unset.
    location / {
        return 301 ${DOCS_URL};
    }

    location /private {
        return 301 ${INTERNAL_DOCS_URL};
    }
}
