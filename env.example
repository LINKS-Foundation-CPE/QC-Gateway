BASE_DOMAIN=example.com
JOB_PORTAL_API_URL=api.example.com
DASHBOARD_URL=dashboard.example.com
FRONTEND_URL=spark.example.com
URL=spark.example.com
EXTRA_DOMAINS=dashboard.example.com,api.example.com,store.example.com,grafana.example.com
# Where docs.$BASE_DOMAIN redirects to. The docs vhost is rendered only when
# DOCS_URL is set; INTERNAL_DOCS_URL backs the /private path and defaults to
# DOCS_URL.
# Upstream behind overview.$BASE_DOMAIN, fronted the way grafana is. SWAG runs
# on the host network, so a service on this machine is http://127.0.0.1:<port>.
# The vhost is rendered only when this is set — and the host name must also be
# covered by the certificate, i.e. listed in EXTRA_DOMAINS above.
#OVERVIEW_UPSTREAM=http://127.0.0.1:3001
#DOCS_URL=https://docs.example.com/
#INTERNAL_DOCS_URL=https://internal-docs.example.com/
# Extra address ranges fail2ban must never ban, on top of the RFC1918 ranges —
# typically the operators' own public range, so a fumbled login from the office
# cannot lock the team out. Space-separated; QUOTE IT (the deploy sources this
# file, so an unquoted space breaks parsing).
#FAIL2BAN_IGNOREIP_EXTRA="203.0.113.0/24"
MACHINE_URL=https://machine.internal
IQM_SERVER_TOKEN=<TOKEN>
# Administrator token for the machine's calibration endpoints, which refuse the
# device token above with 403. Held only by the calibration-poller container.
# Leave unset and calibration uses IQM_SERVER_TOKEN, as before — which still
# works on a machine that has not restricted those endpoints.
#ADMIN_IQM_TOKEN=<ADMIN_TOKEN>
AUTH_URL=https://auth.example.com/auth
MINIO_ROOT_USER=rootadmin
MINIO_ROOT_PASSWORD=rootpass123
MINIO_SERVER_URL=https://store.example.com
# Optional: where the gateway's own S3 client connects, when that should not be
# the public URL above (which links keep using). Unset = MINIO_SERVER_URL.
#S3_ENDPOINT_URL=http://rustfs:9000
# Optional override for the jobs results portal URL; defaults to
# https://jobs.${BASE_DOMAIN}. Needed in deployments without a FQDN
# (see docker-compose.dev.yaml / docs/DEV_DEPLOYMENT.md).
#JOBS_PORTAL_URL=http://10.0.0.5:8940
# Where the object store keeps its data: RustFS under <path>/rustfs. A
# <path>/data left from MinIO can be deleted once rustfs-init says so.
MINIO_STORAGE_PATH=./minio-data
BUCKET_NAME=monitoring-data
APP_USER=tenantuser
APP_PASSWORD=tenantpass123
AWS_ACCESS_KEY_ID=<REDACTED>
AWS_SECRET_ACCESS_KEY=<REDACTED>
CALIBRATION_POLL_INTERVAL=3600

# PostgreSQL credentials for the local jobs database (used by the
# postgres, fastapi-proxy, and reporter services in docker-compose.yaml).
POSTGRES_PASSWORD=<CHANGE_ME>

# S3 endpoint (host:port) used by restic and volumes-backup for off-site
# backups of the object store data and the Postgres volume. Example: backup.example.com:8010
BACKUP_ENDPOINT=<HOST:PORT>
# --- Authentication backends -------------------------------------------------
# Which auth plugins validate bearer tokens, comma-separated, tried in this
# order. Leave unset for the historical behaviour: OIDC/Keycloak JWTs only.
#
#   keycloak  RS256 JWTs verified against KEYCLOAK_JWKS_URL (claims no prefix)
#   sqed      per-job tokens minted by a SLURM SPANK plugin onto the Redis bus,
#             for submissions that come from the scheduler rather than a person
#
# A token carrying a plugin's prefix goes to that plugin alone; anything else
# is offered to the prefix-less plugins in order. So adding `sqed` cannot
# change how an existing JWT is handled.
#AUTH_PLUGINS=keycloak
#AUTH_PLUGINS=keycloak,sqed

# Reject any token without a plugin prefix instead of trying the prefix-less
# plugins. For a deployment that accepts scheduler tokens only.
#STRICT_PREFIX_MODE=false

# --- sqed auth plugin (only read when `sqed` is in AUTH_PLUGINS) -------------
# Token prefix the plugin claims; must not collide with another plugin's.
#SQED_TOKEN_PREFIX=sqed_
# Roles every scheduler-authenticated principal gets. The cluster vouches for
# the account, not for privileges, so this is the plain submit role.
#SQED_DEFAULT_ROLES=cortex_user
# Optional per-user roles lookup on the portal backend, queried as {url}/{user}
# and expected to return {"roles": [...]}. Looked-up roles are ADDED to the
# defaults; failures fall back to the defaults. Empty disables it.
#SQED_ROLES_LOOKUP_URL=http://quantum-api:8500/userRoles
#SQED_ROLES_CACHE_TTL=60
# Only relevant for an https:// lookup URL.
#SQED_ROLES_VERIFY_TLS=true

# --- Submission policy -------------------------------------------------------
# Which policy plugin decides whether a submission may proceed. Leave unset
# for the flat per-user concurrency limits this gateway has always applied.
#
#   passthrough   MAX_CONCURRENT_SHOTS / MAX_CONCURRENT_SWEEPS per user
#   shot_budget   concurrent-shot budget derived from the licenses a batch
#                 scheduler reserved for the job; sweeps keep the flat limit
#POLICY_PLUGIN=passthrough

# --- shot_budget policy plugin (only read when selected) --------------------
# Concurrent active shots granted per held license. The per-principal budget
# is min(n_licenses x SHOTS_PER_LICENSE, MAX_CONCURRENT_SHOTS).
#SHOTS_PER_LICENSE=625000
