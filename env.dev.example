# ── QC Gateway development environment (no FQDN, self-signed TLS) ───────────
# Copy to .env.dev and adjust. Used only by docker-compose.dev.yaml.
#
#   cp env.dev.example .env.dev
#   docker compose -f docker-compose.dev.yaml up -d --build
#
# Replace 192.0.2.10 below with the address clients will use to reach this
# host. All published ports speak HTTPS with the self-signed certificate
# generated in the keycloak-deployment repo (gen-dev-certs.sh); see
# docs/DEV_DEPLOYMENT.md for the full walkthrough.

# Operational mode. "authentication" needs no portal API (quantum-api);
# switch to "production" once quantum-api is running on :8500 to exercise
# the full authorize/report/billing loop.
MIDDLEWARE_MODE=authentication

# ── Upstream machine (mock IQM device or real QC) ────────────────────────────
MACHINE_URL=https://machine.internal
IQM_SERVER_TOKEN=<TOKEN>
# Administrator token for the machine's calibration endpoints, which refuse the
# device token above with 403. Held only by the calibration-poller container.
# Leave unset and calibration uses IQM_SERVER_TOKEN, as before — which still
# works on a machine that has not restricted those endpoints.
#ADMIN_IQM_TOKEN=<ADMIN_TOKEN>
VERIFY_UPSTREAM_SSL=false

# ── Authentication (Keycloak) ────────────────────────────────────────────────
# Dev Keycloak from the keycloak-deployment repo (docker-compose.dev.yaml
# there, realm bootstrapped by bootstrap-dev-realm.sh).
KEYCLOAK_ISSUER=https://192.0.2.10:8843/auth/realms/cortex
KEYCLOAK_JWKS_URL=https://192.0.2.10:8843/auth/realms/cortex/protocol/openid-connect/certs
AUDIENCE=account

# Trust anchors for the self-signed dev cert inside the containers
# (mounted from ../keycloak-deployment/certs; override with KEYCLOAK_CERT_PATH).
SSL_CERT_FILE=/certs/keycloak.crt
REQUESTS_CA_BUNDLE=/certs/keycloak.crt

# ── Object store (RustFS; MINIO_* names kept, RustFS reads them) ─────────────
# MINIO_SERVER_URL is embedded in result links — it must be reachable by
# whoever opens them, so use the host IP, not "localhost".
MINIO_SERVER_URL=https://192.0.2.10:9000
# Optional: where the containers' S3 client connects instead (links keep the
# URL above). Needed when that URL is a loopback address, which inside a
# container is the container itself.
#S3_ENDPOINT_URL=http://rustfs:9000
MINIO_ROOT_USER=root
MINIO_ROOT_PASSWORD=devrootpass
MINIO_STORAGE_PATH=./minio-data
BUCKET_NAME=job-data
APP_USER=tenantuser
APP_PASSWORD=devtenantpass

# ── Jobs results portal (static viewer served by the jobs-portal container) ──
JOBS_PORTAL_URL=https://192.0.2.10:8940

# ── Local jobs DB (gateway-internal Postgres) ────────────────────────────────
POSTGRES_PASSWORD=devpgpass

# ── Portal API (quantum-api backend) ─────────────────────────────────────────
# Only exercised in MIDDLEWARE_MODE=production/reporting. quantum-api serves
# HTTPS natively in dev (SSL_CERT/SSL_KEY in its .env); host.docker.internal
# is included in the dev cert SANs.
PORTAL_API_HOST=https://host.docker.internal:8500

# ── Optional: quantum-dashboard dev server (compose profile "dashboard") ─────
#VITE_API_URL=https://192.0.2.10:8500/api
#VITE_TOKEN_URL=https://192.0.2.10:8500/auth/token
#VITE_KEYCLOAK_URL=https://192.0.2.10:8843/auth
#VITE_KEYCLOAK_REALM=cortex
#VITE_KEYCLOAK_CLIENTID=test-frontend
